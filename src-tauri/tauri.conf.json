{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Repeater Nation",
  "version": "0.2.1",
  "identifier": "com.repeaternation.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Repeater Nation",
        "width": 1180,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "repeaternation-app"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "repeaternation-app"
          ],
          "appLink": false
        }
      ]
    }
  }
}
